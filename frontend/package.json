{
  "name": "tether-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "contracts": "openapi-typescript ../shared/openapi.json -o src/generated/api.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
