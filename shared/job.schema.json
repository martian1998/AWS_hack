{
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "event_version": {
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "notice",
        "outreach",
        "triage",
        "notification",
        "followup"
      ],
      "title": "Kind",
      "type": "string"
    },
    "patient_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patient Id"
    },
    "payload_ref": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^records://",
      "title": "Payload Ref",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_message_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Message Id"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "kind",
    "tenant_id",
    "event_id",
    "event_version",
    "created_at",
    "deadline_at",
    "correlation_id",
    "payload_ref"
  ],
  "title": "JobEnvelope",
  "type": "object"
}
